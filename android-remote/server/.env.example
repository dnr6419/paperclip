# Copy to `.env` (next to docker-compose.yml) and edit before
# `docker compose up -d`. `.env` is gitignored.

# --- option B (TLS via Caddy + Let's Encrypt) ---------------------------
# Domain pointing at this host. Phones will use wss://${DOMAIN}/ as the
# relay URL. Required for `docker compose --profile tls up -d`.
DOMAIN=remote.example.com

# --- option A (LAN-only, plain ws://) -----------------------------------
# Host interface the relay port binds to. Defaults to 127.0.0.1 (only
# the host itself can reach the relay). Set to 0.0.0.0 to expose to the
# LAN — pair phones with `ws://<your-lan-ip>:8765/`. Requires a debug
# app build because the production build refuses non-wss:// URLs.
# RELAY_BIND=0.0.0.0
